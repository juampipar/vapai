# Sin estas variables la app funciona en "modo local" (los datos quedan guardados en el navegador).
# Con Supabase los datos quedan en la nube, con login, y la página pública muestra las experiencias.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Solo en el servidor (Vercel > Environment Variables). NUNCA con prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=
MP_ACCESS_TOKEN=APP_USR-...
MP_WEBHOOK_SECRET=
